{
  "name": "krestel",
  "version": "1.0.0",
  "description": "Krestel - advanced Windows Defender manager: inspect, disable, enable, remove and restore Defender components safely, with plan preview, backups and one-click restore.",
  "main": "./out/main/index.js",
  "author": "Krestel contributors",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc -p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build": "electron-vite build",
    "build:check": "npm run typecheck && npm run build",
    "icon": "node scripts/make-icon.mjs",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "installer": "node scripts/build-installer.cjs",
    "installer:test": "node scripts/test-install.cjs",
    "preview:web": "node scripts/preview-server.cjs"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "tailwindcss": "^4.1.0",
    "tw-animate-css": "^1.2.5",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
